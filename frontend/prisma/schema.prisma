generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String        @id
  email     String?       @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  sessions  UserSession[]
  WatchItem WatchItem[]
  notificationPreferences NotificationPreferences?
  watchlists Watchlist[]
  watchlistMembers WatchlistMember[]
  sentInvitations WatchlistInvitation[]

  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  subscriptionStatus     String    @default("free") // 'free' | 'active' | 'canceled' | 'past_due'
  subscriptionPeriodEnd  DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
}

model UserSession {
  id        Int      @id @default(autoincrement())
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WatchItem {
  id                     Int      @id @default(autoincrement())
  title                  String
  type                   String
  status                 String
  currentSeason          Int?
  totalSeasons           Int?
  createdAt              DateTime @default(now())
  updatedAt              DateTime
  userId                 String
  notes                  String?
  rating                 String?
  tmdbId                 Int?
  tmdbImdbId             String?
  tmdbMovieCertification String?
  tmdbMovieReleaseYear   Int?
  tmdbMovieRuntime       Int?
  tmdbOverview           String?
  tmdbPosterPath         String?
  tmdbTagline            String?
  tmdbTvCertification    String?
  tmdbTvFirstAirYear     Int?
  tmdbTvLastAirYear      Int?
  tmdbTvNetworks         String?
  tmdbTvNumberOfEpisodes Int?
  tmdbTvNumberOfSeasons  Int?
  tmdbTvStatus           String?
  User                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, tmdbId])
}

model NotificationPreferences {
  id                    String   @id @default(cuid())
  userId                String   @unique
  emailEnabled          Boolean  @default(true)
  welcomeEmailSent      Boolean  @default(false)
  weeklyDigestEnabled   Boolean  @default(false)
  monthlyDigestEnabled  Boolean  @default(false)
  newSeasonAlerts       Boolean  @default(true)
  friendActivityAlerts  Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdminNotification {
  id          String   @id @default(cuid())
  type        String   // 'user_activity', 'weekly_summary', 'system_alert'
  title       String
  message     String
  data        Json?    // Additional data for the notification
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([isRead])
  @@index([createdAt])
}

model EmailLog {
  id          String   @id @default(cuid())
  to          String
  subject     String
  template    String   // 'welcome', 'weekly_digest', 'admin_alert'
  status      String   // 'sent', 'failed', 'pending'
  error       String?
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([to])
  @@index([status])
  @@index([createdAt])
}

model Watchlist {
  id          String   @id @default(cuid())
  name        String
  description String?
  isShared    Boolean  @default(false)
  isDefault   Boolean  @default(false) // True for user's default personal list
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members     WatchlistMember[]
  items       WatchlistItemList[]
  invitations WatchlistInvitation[]

  @@index([ownerId])
  @@index([isShared])
}

model WatchlistMember {
  id          String @id @default(cuid())
  watchlistId String
  userId      String
  role        String @default("member") // "owner", "member"
  joinedAt    DateTime @default(now())
  
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, userId])
  @@index([userId])
}

model WatchlistItemList {
  id            String @id @default(cuid())
  watchlistId   String
  watchlistItemId String
  status        String @default("Want to Watch") // "Want to Watch", "Watching", "Finished"
  rating        String? // "Loved", "Liked", "Not for me"
  notes         String?
  addedAt       DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  watchlist     Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  watchlistItem WatchlistItem @relation(fields: [watchlistItemId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, watchlistItemId])
  @@index([watchlistId])
  @@index([watchlistItemId])
}

model WatchlistItem {
  id                     String @id @default(cuid())
  title                  String
  type                   String // "movie", "tv"
  tmdbId                 Int
  tmdbImdbId             String?
  tmdbMovieCertification String?
  tmdbMovieReleaseYear   Int?
  tmdbMovieRuntime       Int?
  tmdbOverview           String?
  tmdbPosterPath         String?
  tmdbTagline            String?
  tmdbTvCertification    String?
  tmdbTvFirstAirYear     Int?
  tmdbTvLastAirYear      Int?
  tmdbTvNetworks         String?
  tmdbTvNumberOfEpisodes Int?
  tmdbTvNumberOfSeasons  Int?
  tmdbTvStatus           String?
  /// TMDB `popularity` (daily score; model uses for reach / buzz framing).
  tmdbPopularity         Float?
  /// TMDB `vote_count` (number of ratings).
  tmdbVoteCount          Int?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  
  watchlists             WatchlistItemList[]

  @@unique([tmdbId])
  @@index([type])
}

model WatchlistInvitation {
  id          String   @id @default(cuid())
  watchlistId String
  email       String
  invitedBy   String
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  inviter     User      @relation(fields: [invitedBy], references: [id], onDelete: Cascade)

  @@unique([watchlistId, email])
  @@index([email])
  @@index([expiresAt])
}
