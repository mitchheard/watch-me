generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String        @id
  email     String?       @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  sessions  UserSession[]
  WatchItem WatchItem[]
  notificationPreferences NotificationPreferences?
}

model UserSession {
  id        Int      @id @default(autoincrement())
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WatchItem {
  id                     Int      @id @default(autoincrement())
  title                  String
  type                   String
  status                 String
  currentSeason          Int?
  totalSeasons           Int?
  createdAt              DateTime @default(now())
  updatedAt              DateTime
  userId                 String
  notes                  String?
  rating                 String?
  tmdbId                 Int?
  tmdbImdbId             String?
  tmdbMovieCertification String?
  tmdbMovieReleaseYear   Int?
  tmdbMovieRuntime       Int?
  tmdbOverview           String?
  tmdbPosterPath         String?
  tmdbTagline            String?
  tmdbTvCertification    String?
  tmdbTvFirstAirYear     Int?
  tmdbTvLastAirYear      Int?
  tmdbTvNetworks         String?
  tmdbTvNumberOfEpisodes Int?
  tmdbTvNumberOfSeasons  Int?
  tmdbTvStatus           String?
  User                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, tmdbId])
}

model NotificationPreferences {
  id                    String   @id @default(cuid())
  userId                String   @unique
  emailEnabled          Boolean  @default(true)
  welcomeEmailSent      Boolean  @default(false)
  weeklyDigestEnabled   Boolean  @default(false)
  monthlyDigestEnabled  Boolean  @default(false)
  newSeasonAlerts       Boolean  @default(true)
  friendActivityAlerts  Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdminNotification {
  id          String   @id @default(cuid())
  type        String   // 'user_activity', 'weekly_summary', 'system_alert'
  title       String
  message     String
  data        Json?    // Additional data for the notification
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([isRead])
  @@index([createdAt])
}

model EmailLog {
  id          String   @id @default(cuid())
  to          String
  subject     String
  template    String   // 'welcome', 'weekly_digest', 'admin_alert'
  status      String   // 'sent', 'failed', 'pending'
  error       String?
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([to])
  @@index([status])
  @@index([createdAt])
}
